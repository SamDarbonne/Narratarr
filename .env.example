# Narratarr's environment variables. Read APP-CONTRACT.md section 10.
#
# Copy this file to .env, then edit .env. `docker compose` reads .env
# next to docker-compose.yml automatically.
#
# WARNING: never commit .env. It is excluded in .gitignore. This file,
# .env.example, holds only safe example values, and it stays committed.

# --- paths ---------------------------------------------------------------

# The state directory: the database, the downloaded models, the ingested
# library, and each book's work directory. Refer to APP-CONTRACT.md
# section 2.1.
NARRATARR_CONFIG_DIR=/config

# The default folder target's root. Refer to APP-CONTRACT.md section 8.1.
NARRATARR_OUTPUT_DIR=/output

# The watch folder. Drop an EPUB here to make a job. Refer to
# APP-CONTRACT.md section 7.
NARRATARR_WATCH_DIR=/watch

# --- the server -----------------------------------------------------------

# The listen port inside the container. Map a different published port in
# docker-compose.yml; leave this at 8000 unless you also change the
# HEALTHCHECK and the CMD in the Dockerfile.
NARRATARR_PORT=8000

# One of: debug, info, warning, error.
NARRATARR_LOG_LEVEL=info

# A bootstrap API key. Leave this empty and Narratarr makes one on first
# run, then prints it once to the log. Set it here only when you need a
# known key from the first start, for example in an automated test
# environment. WARNING: this is a real secret when set. Never commit a
# real value; the example below is not a usable key.
NARRATARR_API_KEY=change-me-or-leave-blank-to-auto-generate

# --- the TTS engine --------------------------------------------------------

# The TTS engine. kokoro_cpu is the only engine this image installs.
NARRATARR_ENGINE=kokoro_cpu

# The Kokoro voice. Refer to https://huggingface.co/hexgrad/Kokoro-82M for
# the full voice list.
NARRATARR_VOICE=bm_george

# a = American English, b = British English.
NARRATARR_LANG_CODE=b

# The torch thread count. Match this to the compose `cpus` cap, so
# Narratarr does not oversubscribe the machine it runs on.
NARRATARR_NUM_THREADS=3

# --- the whisper QC engine --------------------------------------------------

NARRATARR_WHISPER_BACKEND=faster

# WARNING: this is a placeholder. P0 is measuring peak RAM on the target
# machine now, and the real default ships in APP-CONTRACT.md section 12
# once that measurement lands. Until then, set this to a real
# faster-whisper CTranslate2 model repo id before you start a render, for
# example a Systran/faster-whisper-* repo on the Hugging Face Hub.
NARRATARR_WHISPER_MODEL=PLACEHOLDER-set-by-P0-after-the-RAM-measurement

# --- the human-review gates --------------------------------------------------

# The sample gate of APP-CONTRACT.md section 9.1. Keep this on unless you
# want an unattended run.
NARRATARR_SAMPLE_GATE=true

# Refer to APP-CONTRACT.md section 5.2, rule 4. Pruning turns a one-chunk
# fix into a whole-chapter re-render. Off by default.
NARRATARR_PRUNE=false

# --- targets -----------------------------------------------------------------

# The Audiobookshelf API token. Create it in the Audiobookshelf user
# interface; Narratarr never asks for a password. Refer to APP-CONTRACT.md
# section 8.2. Leave unset until you add an audiobookshelf target.
NARRATARR_ABS_TOKEN=

# --- not yet in APP-CONTRACT.md's table (see docs/api.md and the packaging report) -----

# How often, in seconds, Narratarr polls /watch for a new EPUB. Refer to
# APP-CONTRACT.md section 7.
NARRATARR_WATCH_INTERVAL_S=60

# When true, Narratarr deletes a file from /watch after it copies the
# file into /config/library. Refer to APP-CONTRACT.md section 7.
NARRATARR_WATCH_DELETE_AFTER_INGEST=false

# The events table caps at this many rows per job; the runner deletes
# the oldest rows past this count. Refer to APP-CONTRACT.md section 4.5.
NARRATARR_EVENTS_PER_JOB_MAX=5000

# --- required image default ---------------------------------------------------

# WARNING: required, not optional. The HuggingFace xet transport fails on
# at least one machine in this project, and the failure is confusing. The
# Dockerfile already sets this; it is listed here so a person who runs
# Narratarr outside Docker sees it too. Refer to APP-CONTRACT.md section
# 11.1.
HF_HUB_DISABLE_XET=1
