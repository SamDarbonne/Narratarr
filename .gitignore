# Secrets. Never commit one.
.env
*.pem
*.key

# The Python environment and the build output
.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# The frontend
web/node_modules/
web/dist/

# The runtime state. These directories are mounted, not committed.
config/
output/
watch/
*.db
*.db-wal
*.db-shm

# The downloaded models
models/

# The test output
.pytest_cache/
.coverage
htmlcov/

# macOS
.DS_Store

# The proof session fixture holds a live API key. It never enters the repo.
proof/seeds/*.storage.json

# The proof scratch output. Regenerated by every run.
proof/.proof-out/
